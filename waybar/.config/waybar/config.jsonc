{
  "layer": "top",
  "position": "top",
  "name": "notch",
  "height": 54,
  "width": 540,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "mode": "hide",
  "exclusive": false,
  "fixed-center": true,
  "start_hidden": true,
  "reload_style_on_change": true,
  "on-sigusr1": "hide",
  "on-sigusr2": "show",

  "modules-left": [],

  "modules-center": [
    "clock",
    "hyprland/workspaces",
    "custom/notifications"
  ],

  "modules-right": [],

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "sort-by": "number",
    "format": "{id}"
  },

  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "tooltip": false,
    "on-click": "bash ~/.config/waybar/scripts/calendar-popup.sh"
  },

  "custom/notifications": {
    "tooltip": false,
    "format": "󰂚",
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
